{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--executablePath",
        "${CHROME_EXECUTABLE:-/opt/pw-browsers/chromium}",
        "--chromeArg=--no-sandbox",
        "--chromeArg=--disable-dev-shm-usage",
        "--viewport",
        "1280x720",
        "--no-usage-statistics"
      ]
    }
  }
}
